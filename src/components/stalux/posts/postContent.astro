---
import { fade } from "astro:transitions";
import style from "@styles/components/posts/postContent.module.css";
import "@styles/components/markdown.css";
import { getCollection } from "astro:content";
import { toMachineDateTime } from "@utils/semantic-time";

interface Props {
    title: string;
    date?: string;
    updated?: string;
    readingTime?: string;
    wordCount?: number;
    hasImage?: boolean;
    categories?: string[];
    tags?: string[];
}

const props = Astro.props as Props;
const stalux = (await getCollection("config"))[0]?.data;
const timezone = stalux?.timezone;
const categories = props.categories ?? [];
---

<article
    class={style.articleContent}
    transition:name="post-content"
    transition:animate={fade({ duration: "1.2s" })}>
    <!-- Breadcrumb Navigation -->
    <nav class={style.breadcrumb}>
        <a href="/" class={style.breadcrumbLink}>首页</a>
        <span class={style.breadcrumbSeparator}>/</span>
        <a href="/categories" class={style.breadcrumbLink}>文章</a>
        {categories.length > 0 && (
            <>
                <span class={style.breadcrumbSeparator}>/</span>
                <a href={`/categories/${categories[0]}`} class={style.breadcrumbLink}>{categories[0]}</a>
            </>
        )}
    </nav>

    <!-- Article Header -->
    <header class={style.articleHeader}>
        <h1 class={style.title}>{props.title}</h1>
        <div class={style.metaRow}>
            {
                props.date && (
                    <span class={style.metaItem}>
                        <span class={style.metaIcon}>📅</span>
                        发布于 {props.date}
                    </span>
                )
            }
            {
                props.updated && (
                    <span class={style.metaItem}>
                        <span class={style.metaIcon}>🔄</span>
                        更新于 {props.updated}
                    </span>
                )
            }
        </div>
        <div class={style.metaRow}>
            {props.readingTime && (
                <span class={style.metaItem}>
                    <span class={style.metaIcon}>⏱️</span>
                    阅读时间 {props.readingTime}
                </span>
            )}
            {props.wordCount && props.wordCount > 0 && (
                <span class={style.metaItem}>
                    <span class={style.metaIcon}>📝</span>
                    字数 {props.wordCount}
                </span>
            )}
            <span class={style.metaItem}>
                <span class={style.metaIcon}>👁️</span>
                阅读量 <span id="vercount_value_page_pv">Loading...</span>
            </span>
        </div>
    </header>

    <!-- Article Body -->
    <div class={style.body} data-pagefind-body>
        <slot />
    </div>
</article>

{
    props.hasImage && (
        <script>
            import PhotoSwipeLightbox from "photoswipe/lightbox";
            import PhotoSwipe from "photoswipe";

            function enrichPhotoSwipeData() {
                const container = document.querySelector("[data-pagefind-body]");
                if (!container) return;

                const links = container.querySelectorAll("a[data-pswp]");
                links.forEach((link) => {
                    const img = link.querySelector("img");
                    if (!img) return;

                    const tempImg = new Image();
                    tempImg.onload = () => {
                        link.setAttribute(
                            "data-pswp-width",
                            String(tempImg.naturalWidth),
                        );
                        link.setAttribute(
                            "data-pswp-height",
                            String(tempImg.naturalHeight),
                        );
                    };
                    tempImg.src = img.src;
                });
            }

            function initLightbox() {
                enrichPhotoSwipeData();
                const lightbox = new PhotoSwipeLightbox({
                    gallery: "[data-pagefind-body]",
                    children: "a[data-pswp]",
                    pswpModule: PhotoSwipe,
                    initialZoomLevel: "fill",
                });
                lightbox.init();
            }

            document.addEventListener("astro:page-load", initLightbox);
        </script>
    )
}
